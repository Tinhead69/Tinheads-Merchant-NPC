<form class="item-browser-layout">
  <aside class="item-browser-sidebar">
    <section class="filter-pane type-pane">
      <h3>Item Types</h3>
      <div class="filter-list">
        {{#each types as |type|}}<label><input type="checkbox" name="itemType" value="{{type.value}}" {{#if type.checked}}checked{{/if}}><span>{{type.label}}</span></label>{{else}}<p class="empty">No item types found.</p>{{/each}}
      </div>
    </section>
    <button type="button" class="apply-filters" data-action="applyFilters">Apply Filters</button>
    <section class="filter-pane source-pane">
      <h3>Compendiums &amp; World Items</h3>
      <div class="filter-list">
        {{#each sources as |source|}}<label><input type="checkbox" name="itemSource" value="{{source.id}}" {{#if source.checked}}checked{{/if}}><span>{{source.label}}</span><small>{{source.count}}</small></label>{{else}}<p class="empty">No sources contain the selected item types.</p>{{/each}}
      </div>
    </section>
  </aside>

  <main class="item-browser-main">
    <section class="table-generator">
      <h3>Generate from a Rollable Table</h3>
      <div class="table-controls">
        <select name="rollTableUuid"><option value="">Choose a world or compendium table…</option>{{#each tables as |table|}}<option value="{{table.uuid}}">{{table.name}} — {{table.source}}</option>{{/each}}</select>
        <label>Draws<input name="tableDraws" type="number" min="1" max="100" step="1" value="1"></label>
        <button type="button" data-action="rollTable">Roll &amp; Add</button>
      </div>
      <p class="hint">Table results must link to Item documents to be added automatically.</p>
    </section>

    <section class="available-items">
      <div class="available-heading"><h3>Available Items <span>{{items.length}}</span></h3><label>Search<input name="itemSearch" type="search" value="{{search}}" placeholder="Search item names"></label><button type="button" data-action="applyFilters">Apply</button></div>
      <div class="random-controls"><strong>Random stock</strong><label>Number of items<input name="randomCount" type="number" min="1" max="100" value="{{randomCount}}"></label><button type="button" data-action="randomItems">Add Random Items</button></div>
      <ul class="available-item-list">
        {{#each items as |item|}}
          <li title="{{item.description}}"><img src="{{item.img}}" alt=""><div class="available-item-name"><strong>{{item.name}}</strong><small>{{item.typeLabel}} · {{item.sourceLabel}}</small></div><button type="button" data-action="addItem" data-source="{{item.source}}" data-item="{{item._id}}">Add Item</button></li>
        {{else}}<li class="empty">Choose item types and sources, then apply the filters.</li>{{/each}}
      </ul>
    </section>
    <footer><span>Items added here appear on the merchant sheet immediately.</span><button type="button" data-action="done">Done</button></footer>
  </main>
</form>
